#!/bin/bash

# Ubuntu System Update Script
# This script updates the Ubuntu system using various package managers
# Usage: sudo upall [--verbose|-v]

# Set script variables
SCRIPT_DIR="/opt/update-all"
LOG_FILE="$SCRIPT_DIR/update_log.txt"
ERROR_COUNT=0
TOTAL_COMMANDS=0
VERBOSE=false

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Function to parse command line arguments
parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -h|--help)
                echo "Usage: sudo upall [--verbose|-v]"
                echo ""
                echo "Options:"
                echo "  -v, --verbose    Show detailed output on terminal as well as in log file"
                echo "  -h, --help       Show this help message"
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use -h or --help for usage information"
                exit 1
                ;;
        esac
    done
}

# Function to log command output
log_command() {
    local command=$1
    local description=$2

    ((TOTAL_COMMANDS++))

    print_status $BLUE "Running: $description"
    echo "===========================================" >> "$LOG_FILE"
    echo "Command: $command" >> "$LOG_FILE"
    echo "Timestamp: $(date)" >> "$LOG_FILE"
    echo "===========================================" >> "$LOG_FILE"

    # Run command and capture both stdout and stderr
    if [[ "$VERBOSE" == "true" ]]; then
        # In verbose mode, show output on terminal and log to file
        if eval "$command" 2>&1 | tee -a "$LOG_FILE"; then
            print_status $GREEN "✓ Success: $description"
            echo "Status: SUCCESS" >> "$LOG_FILE"
        else
            print_status $RED "✗ Failed: $description"
            echo "Status: FAILED" >> "$LOG_FILE"
            ((ERROR_COUNT++))
        fi
    else
        # Normal mode, only log to file
        if eval "$command" >> "$LOG_FILE" 2>&1; then
            print_status $GREEN "✓ Success: $description"
            echo "Status: SUCCESS" >> "$LOG_FILE"
        else
            print_status $RED "✗ Failed: $description"
            echo "Status: FAILED" >> "$LOG_FILE"
            ((ERROR_COUNT++))
        fi
    fi

    echo "" >> "$LOG_FILE"
}

# Function to check if running as root
check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_status $RED "This script must be run as root (use sudo)"
        exit 1
    fi
}

# Return 0 when $1 is a non-root local user that exists
is_valid_user() {
    [[ -n "$1" ]] && [[ "$1" != "root" ]] && id "$1" &>/dev/null
}

# Load optional machine-local settings (e.g. UPDATE_GIT_REPOS_USER)
load_config() {
    local config_file="$SCRIPT_DIR/config.env"
    if [[ -f "$config_file" ]]; then
        # shellcheck source=/dev/null
        set -a
        source "$config_file"
        set +a
    fi
}

# Function to get the actual non-root user
get_actual_user() {
    local user=""

    # Method 0: explicit env/config
    if is_valid_user "$UPDATE_GIT_REPOS_USER"; then
        echo "$UPDATE_GIT_REPOS_USER"
        return 0
    fi

    # Method 1: SUDO_USER (most reliable when using sudo)
    if is_valid_user "$SUDO_USER"; then
        echo "$SUDO_USER"
        return 0
    fi

    # Method 2: username from SUDO_UID
    if [[ -n "$SUDO_UID" ]]; then
        user=$(id -nu "$SUDO_UID" 2>/dev/null)
        if is_valid_user "$user"; then
            echo "$user"
            return 0
        fi
    fi

    # Method 3: logname (may return root when invoked as root — try next methods if so)
    if command -v logname &> /dev/null; then
        user=$(logname 2>/dev/null)
        if is_valid_user "$user"; then
            echo "$user"
            return 0
        fi
    fi

    # Method 4: active TTY session user
    if command -v who &> /dev/null; then
        user=$(who -m | awk '{print $1}' 2>/dev/null)
        if is_valid_user "$user"; then
            echo "$user"
            return 0
        fi
    fi

    # Method 5: owner of the script directory (cron/systemd root runs)
    if [[ -n "$SCRIPT_DIR" ]] && [[ -d "$SCRIPT_DIR" ]]; then
        user=$(stat -c '%U' "$SCRIPT_DIR" 2>/dev/null)
        if is_valid_user "$user"; then
            echo "$user"
            return 0
        fi
    fi

    # Method 6: owner of a non-root home directory
    if [[ -n "$HOME" ]] && [[ "$HOME" != "/root" ]]; then
        user=$(stat -c '%U' "$HOME" 2>/dev/null)
        if is_valid_user "$user"; then
            echo "$user"
            return 0
        fi
    fi

    # Method 7: USER variable (last resort)
    if is_valid_user "$USER"; then
        echo "$USER"
        return 0
    fi

    return 1
}

# Function to ensure update-git-repos is available
ensure_update_git_repos() {
    # Check if update-git-repos is already in PATH
    if command -v update-git-repos &> /dev/null; then
        return 0
    fi

    print_status $YELLOW "⚠ update-git-repos not found, installing..."

    # Check if git is installed
    if ! command -v git &> /dev/null; then
        print_status $RED "✗ Git is not installed. Cannot clone update-git-repos repository."
        print_status $YELLOW "⚠ Skipping update-git-repos installation"
        return 1
    fi

    # Get the actual non-root user (needed for ownership)
    local actual_user=""
    if actual_user=$(get_actual_user); then
        :
    else
        actual_user=""
    fi
    local repo_dir="/opt/update-git-repos"
    local script_path="$repo_dir/src/update_repos.py"
    local symlink_path="/usr/bin/update-git-repos"

    # Clone the repository
    if [ -d "$repo_dir" ]; then
        print_status $YELLOW "⚠ Directory $repo_dir already exists, removing it first..."
        rm -rf "$repo_dir"
    fi

    print_status $BLUE "Cloning update-git-repos repository..."
    if git clone https://github.com/s0m3OnE47/update-git-repos "$repo_dir" >> "$LOG_FILE" 2>&1; then
        print_status $GREEN "✓ Repository cloned successfully"
    else
        print_status $RED "✗ Failed to clone repository"
        return 1
    fi

    # Make the script executable
    if chmod +x "$script_path" >> "$LOG_FILE" 2>&1; then
        print_status $GREEN "✓ Made script executable"
    else
        print_status $RED "✗ Failed to make script executable"
        return 1
    fi

    # Set ownership to the actual user (if determinable)
    if [[ -n "$actual_user" ]]; then
        if chown -R "$actual_user:$actual_user" "$repo_dir" >> "$LOG_FILE" 2>&1; then
            print_status $GREEN "✓ Set ownership to $actual_user"
        else
            print_status $YELLOW "⚠ Failed to set ownership (non-critical)"
        fi
    else
        print_status $YELLOW "⚠ Could not determine non-root user for ownership; leaving as current owner"
    fi

    # Create symlink
    if ln -sf "$script_path" "$symlink_path" >> "$LOG_FILE" 2>&1; then
        print_status $GREEN "✓ Created symlink at $symlink_path"
    else
        print_status $RED "✗ Failed to create symlink"
        return 1
    fi

    print_status $GREEN "✓ update-git-repos installed successfully"
    return 0
}

# Function to create log file header
create_log_header() {
    echo "===========================================" > "$LOG_FILE"
    echo "Ubuntu System Update Log" >> "$LOG_FILE"
    echo "Started: $(date)" >> "$LOG_FILE"
    echo "===========================================" >> "$LOG_FILE"
    echo "" >> "$LOG_FILE"
}

# Function to display final summary
display_summary() {
    echo ""
    print_status $BLUE "==========================================="
    print_status $BLUE "UPDATE SUMMARY"
    print_status $BLUE "==========================================="

    if [[ $TOTAL_COMMANDS -eq 0 ]]; then
        print_status $YELLOW "⚠ No update commands were executed"
    elif [[ $ERROR_COUNT -eq 0 ]]; then
        print_status $GREEN "✓ All updates completed successfully!"
        print_status $GREEN "✓ $TOTAL_COMMANDS/$TOTAL_COMMANDS commands executed without errors"
    else
        print_status $RED "✗ $ERROR_COUNT out of $TOTAL_COMMANDS commands failed"
        print_status $YELLOW "Check the log file for details: $LOG_FILE"
    fi

    if [[ "$VERBOSE" == "true" ]]; then
        print_status $BLUE "Verbose mode: Output displayed on terminal and saved to: $LOG_FILE"
    else
        print_status $BLUE "Verbose output saved to: $LOG_FILE"
    fi
    print_status $BLUE "Completed: $(date)"
    print_status $BLUE "==========================================="
}

# Main execution
main() {
    # Parse command line arguments
    parse_arguments "$@"

    # Check if running as root
    check_root

    # Load machine-local config before user detection
    load_config

    # Clear screen and show header
    clear
    print_status $BLUE "==========================================="
    print_status $BLUE "Ubuntu System Update Script"
    print_status $BLUE "==========================================="
    print_status $YELLOW "Starting system update at $(date)"
    print_status $BLUE "==========================================="

    # Create log file header
    create_log_header

    # Ensure update-git-repos is available
    ensure_update_git_repos

    # Update package lists
    log_command "apt update -y" "Update package lists"

    # Upgrade installed packages
    log_command "apt upgrade -y" "Upgrade installed packages"

    # Remove unnecessary packages
    log_command "apt autoremove -y" "Remove unnecessary packages"

    # Update snap packages
    log_command "snap refresh" "Update snap packages"

    # Update Cursor (if available)
    log_command "/opt/update-cursor/bin/update-cursor --no-progress-bar" "Update Cursor editor"

    # Additional Ubuntu update commands
    log_command "apt full-upgrade -y" "Full system upgrade (handles dependencies)"
    log_command "apt autoclean" "Clean package cache"

    # Update Flatpak packages (if available)
    if command -v flatpak &> /dev/null; then
        log_command "flatpak update -y" "Update Flatpak packages"
    else
        print_status $YELLOW "⚠ Flatpak not installed, skipping Flatpak updates"
    fi

    # Renew TLS certificates (aniketdhere.com, life.aniketdhere.com, folio.aniketdhere.com)
    if command -v certbot &> /dev/null; then
        log_command "certbot renew --quiet --deploy-hook 'systemctl reload nginx'" "Renew Let's Encrypt certificates"
    else
        print_status $YELLOW "⚠ certbot not installed, skipping certificate renewal"
    fi

    # Update AppImage applications (if available)
    if command -v update-appimages &> /dev/null && command -v install-appimage &> /dev/null; then
        log_command "update-appimages" "Update AppImage applications"
    else
        print_status $YELLOW "⚠ update-appimages or install-appimage not available, skipping AppImage updates"
        echo "===========================================" >> "$LOG_FILE"
        echo "Command: update-appimages" >> "$LOG_FILE"
        echo "Timestamp: $(date)" >> "$LOG_FILE"
        echo "Status: SKIPPED - Command not found in PATH" >> "$LOG_FILE"
        echo "" >> "$LOG_FILE"
    fi

    # Update git repositories (if available)
    if command -v update-git-repos &> /dev/null; then
        # Get the actual non-root user using multiple detection methods
        local actual_user
        if actual_user=$(get_actual_user); then
            # Always run as the actual user, never as root
            log_command "sudo -u \"$actual_user\" -H update-git-repos" "Update git repositories"
        else
            print_status $YELLOW "⚠ Cannot determine non-root user, skipping git repository updates"
            print_status $YELLOW "⚠ update-git-repos must be run as a non-root user"
            print_status $YELLOW "⚠ You can specify the user by setting: UPDATE_GIT_REPOS_USER=yourusername"
            print_status $YELLOW "⚠ Example: sudo UPDATE_GIT_REPOS_USER=yourusername upall"
            echo "===========================================" >> "$LOG_FILE"
            echo "Command: update-git-repos" >> "$LOG_FILE"
            echo "Timestamp: $(date)" >> "$LOG_FILE"
            echo "Status: SKIPPED - Cannot determine non-root user" >> "$LOG_FILE"
            echo "Debug: SUDO_USER=$SUDO_USER, SUDO_UID=$SUDO_UID, USER=$USER, UPDATE_GIT_REPOS_USER=$UPDATE_GIT_REPOS_USER" >> "$LOG_FILE"
            echo "" >> "$LOG_FILE"
        fi
    else
        print_status $YELLOW "⚠ update-git-repos not available, skipping git repository updates"
        echo "===========================================" >> "$LOG_FILE"
        echo "Command: update-git-repos" >> "$LOG_FILE"
        echo "Timestamp: $(date)" >> "$LOG_FILE"
        echo "Status: SKIPPED - Command not found in PATH" >> "$LOG_FILE"
        echo "" >> "$LOG_FILE"
    fi

    # Update Hermes agent (user install under ~/.local/bin)
    local actual_user hermes_bin user_home
    if actual_user=$(get_actual_user); then
        user_home=$(getent passwd "$actual_user" | cut -d: -f6)
        hermes_bin="${user_home}/.local/bin/hermes"
        if [[ -x "$hermes_bin" ]]; then
            # Always run as the actual user; -y keeps cron/sudo runs non-interactive
            log_command "sudo -u \"$actual_user\" -H \"$hermes_bin\" update -y" "Update Hermes agent"
        else
            print_status $YELLOW "⚠ hermes not found for $actual_user, skipping Hermes update"
            echo "===========================================" >> "$LOG_FILE"
            echo "Command: hermes update -y" >> "$LOG_FILE"
            echo "Timestamp: $(date)" >> "$LOG_FILE"
            echo "Status: SKIPPED - hermes not found at $hermes_bin" >> "$LOG_FILE"
            echo "" >> "$LOG_FILE"
        fi
    else
        print_status $YELLOW "⚠ Cannot determine non-root user, skipping Hermes update"
        print_status $YELLOW "⚠ hermes must be run as a non-root user"
        print_status $YELLOW "⚠ You can specify the user by setting: UPDATE_GIT_REPOS_USER=yourusername"
        echo "===========================================" >> "$LOG_FILE"
        echo "Command: hermes update -y" >> "$LOG_FILE"
        echo "Timestamp: $(date)" >> "$LOG_FILE"
        echo "Status: SKIPPED - Cannot determine non-root user" >> "$LOG_FILE"
        echo "Debug: SUDO_USER=$SUDO_USER, SUDO_UID=$SUDO_UID, USER=$USER, UPDATE_GIT_REPOS_USER=$UPDATE_GIT_REPOS_USER" >> "$LOG_FILE"
        echo "" >> "$LOG_FILE"
    fi

    # Check if reboot is required
    if [ -f /var/run/reboot-required ]; then
        print_status $YELLOW "⚠ System reboot is required after updates"
        echo "Reboot required: YES" >> "$LOG_FILE"
    else
        print_status $GREEN "✓ No reboot required"
        echo "Reboot required: NO" >> "$LOG_FILE"
    fi

    # Display final summary
    display_summary

    # # Summarize the update log with Ollama (if installed)
    # if ollama --version >/dev/null 2>&1; then
    #     cat /opt/update-all/update_log.txt | ollama run gpt-oss:20b "You are given an update log for the System update & upgrade script. Using only this log, summarize the changes to system in a concise list: Important packages that were updated, which were removed, snap packages updated, cursor version updated from and to, flatpack update, miscellaneous changes. The output is displayed on the terminal, hence avoid using markdown formatting."
    # else
    #     print_status $YELLOW "⚠ Ollama not installed, skipping summary"
    # fi

    # Exit with appropriate code
    if [[ $ERROR_COUNT -eq 0 ]]; then
        exit 0
    else
        exit 1
    fi
}

# Run main function
main "$@"
